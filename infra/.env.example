# Copy to infra/.env and fill in. Generate secrets with:  openssl rand -hex 32

# Starts Caddy for HTTPS. Delete this line if the server already runs nginx on ports 80/443
# and follow docs/deploy-vps.md, "Server already runs nginx".
COMPOSE_PROFILES=caddy

# Two DNS A records pointing at the VPS public IP
APP_DOMAIN=app.example.com
LIVEKIT_DOMAIN=livekit.example.com

POSTGRES_PASSWORD=
REDIS_PASSWORD=
SESSION_SECRET=
INTERNAL_API_TOKEN=

# LiveKit keys are yours to invent. The secret must be at least 32 characters.
LIVEKIT_API_KEY=APIvoice
LIVEKIT_API_SECRET=

# AI providers
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=

# Default for public sign-up until it's changed in Admin > Settings (the admin setting wins after that).
ALLOW_SIGNUP=true

# Your login email(s), comma-separated. These users always get the admin panel at /admin.
PLATFORM_ADMIN_EMAILS=

# Optional backup LLM on any OpenAI-compatible API, used if OpenAI fails mid-call.
# Example for Groq: https://api.groq.com/openai/v1 + your Groq key + a model name from Groq's docs.
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=

# Carrier signalling IPs allowed to send calls to your SIP server (comma-separated IPs or CIDRs).
# Copy the current lists from Telnyx's and Twilio's docs (see docs/telephony.md). Used by setup_sip.py.
TELNYX_SIP_IPS=
TWILIO_SIP_IPS=
