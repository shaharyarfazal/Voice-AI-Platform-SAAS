# Copy to infra/.env and fill in. Generate secrets with:  openssl rand -hex 32

# Two DNS A records pointing at the VPS public IP
APP_DOMAIN=app.example.com
LIVEKIT_DOMAIN=livekit.example.com

POSTGRES_PASSWORD=
REDIS_PASSWORD=
SESSION_SECRET=
INTERNAL_API_TOKEN=

# LiveKit keys are yours to invent. The secret must be at least 32 characters.
LIVEKIT_API_KEY=APIvoice
LIVEKIT_API_SECRET=

# AI providers
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=

# Set to false to stop new companies signing up on their own
ALLOW_SIGNUP=true

# Carrier signalling IPs allowed to send calls to your SIP server (comma-separated IPs or CIDRs).
# Copy the current lists from Telnyx's and Twilio's docs (see docs/telephony.md). Used by setup_sip.py.
TELNYX_SIP_IPS=
TWILIO_SIP_IPS=
