# Environment for the web app on Vercel (Project → Settings → Environment Variables).
# The voice server (LiveKit, SIP, agent worker, scheduler) stays on the VPS; see docs/deploy-vercel.md.

# Managed Postgres. Use the provider's pooled connection string (Neon "-pooler" host, Supabase pooler).
DATABASE_URL=
# On Supabase use the session pooler (port 5432), not the transaction pooler (6543): queries can
# hang on 6543. Set this to false only for a transaction-mode pooler such as PgBouncer.
DATABASE_PREPARE=true

SESSION_SECRET=
INTERNAL_API_TOKEN=
ENCRYPTION_KEY=
APP_URL=https://app.example.com
PLATFORM_NAME=
PLATFORM_ADMIN_EMAILS=
ALLOW_SIGNUP=true

# The brand this deployment serves: hvac, limo, ...
BRAND_ID=default

# LiveKit on the VPS (browser test calls and widgets connect here; the web app creates rooms and tokens).
NEXT_PUBLIC_LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# LiveKit's HTTP API, for outbound calls and room management. Public https on the VPS.
LIVEKIT_HTTP_URL=https://livekit.example.com

# Scheduling engine on the VPS, behind https.
SCHEDULER_URL=https://scheduler.example.com
SCHED_JWT_SECRET=

# Call recordings in object storage (Cloudflare R2, S3, B2). Required on Vercel.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=voice-recordings
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Stripe (hosted Checkout + Customer Portal only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_CATALOG=

# Vercel Cron authenticates with this; any random 32+ characters.
CRON_SECRET=

# AI providers used by the web app itself (knowledge embeddings, chatbots, model/voice lists).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
ELEVEN_API_KEY=
CARTESIA_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
